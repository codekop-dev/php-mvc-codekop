{
    "name": "codekop/php-mvc-codekop",
    "description": "Modern PHP MVC starter framework",
    "type": "project",
    "require": { "php": ">=8.2" },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "php-debugbar/php-debugbar": "^3.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "System\\": "system/",
            "App\\": "app/"
        }
    },
    "config": { "sort-packages": true, "allow-plugins": {} },
    "scripts": {
        "queue:work": "@php system/console.php queue:work",
        "bench:api": "@php system/console.php api:bench",
        "test": "@php vendor/bin/phpunit",
        "cs:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix"
    }
}
