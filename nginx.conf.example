# Contoh server block Nginx untuk Codekop POS.
#
# Salin ke konfigurasi site Nginx, lalu sesuaikan:
# - root
# - fastcgi_pass (socket PHP-FPM)
# - server_name
#
# File ini tidak otomatis dipakai oleh Nginx.

server {
    listen 80;
    listen [::]:80;
    server_name pos.example.test;

    root /var/www/php-mvc-codekop;
    index index.php;

    # Upload logo, avatar, dan gambar barang dibatasi seperti validasi aplikasi.
    client_max_body_size 20m;

    # Jangan tampilkan isi folder.
    autoindex off;

    # Folder internal aplikasi tidak boleh diakses dari web.
    location ~* ^/(?:app|system|storage|database|vendor|\.git|\.agents|\.codex)(?:/|$) {
        return 404;
    }

    # File tersembunyi dan file konfigurasi/backup tidak boleh diunduh.
    location ~* /\.(?!well-known/) {
        return 404;
    }

    location ~* \.(?:env|ini|log|sql|bak|dist|fla|psd|sh)$ {
        return 404;
    }

    # Assets bersifat publik, tetapi file executable di dalamnya tetap diblokir.
    location ~* ^/assets/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)$ {
        return 404;
    }

    # Semua route aplikasi masuk melalui front controller.
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Hanya front controller yang boleh diteruskan ke PHP-FPM.
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    # Jangan eksekusi file PHP lain meskipun suatu saat ter-upload/ter-copy.
    location ~ \.php$ {
        return 404;
    }
}
